{
  "name": "@keelson/rib-adme",
  "version": "1.14.0",
  "description": "Keelson rib for administering an Azure Data Manager for Energy instance: who has access, what data is in it, and who can reach each seismic subproject.",
  "license": "Apache-2.0",
  "author": "Daniel Scholl",
  "homepage": "https://github.com/danielscholl/keelson-rib-adme#readme",
  "bugs": {
    "url": "https://github.com/danielscholl/keelson-rib-adme/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielscholl/keelson-rib-adme.git"
  },
  "keywords": [
    "keelson",
    "rib",
    "adme",
    "osdu",
    "azure",
    "energy"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "link:keelson": "bun dev/link.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@keelson/shared": "https://github.com/danielscholl/keelson/releases/download/v0.128.1/keelson-shared.tgz",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@keelson/shared": ">=0.128.1"
  },
  "peerDependenciesMeta": {
    "@keelson/shared": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
